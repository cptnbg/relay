# Probe / session scratch output
*.out
*.err
*.log
.DS_Store

# Babysitter plugin runtime state — never part of this repo
.a5c/

# Nothing generated by a test run belongs in git
src/step*.txt

# A relay state directory has turned up here after running things by hand from
# the repository root. Relay stages untracked non-ignored files, so without
# this line one of those gets auto-committed. `test/run.sh` itself keeps its
# state inside a mktemp sandbox and does not create this.
/state/
