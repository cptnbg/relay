# Probe / session scratch output
*.out
*.err
*.log
.DS_Store

# Babysitter plugin runtime state — never part of this repo
.a5c/

# Nothing generated by a test run belongs in git
src/step*.txt

# A relay state directory has turned up here after running things by hand from
# the repository root. Relay stages untracked non-ignored files, so without
# this line one of those gets auto-committed. `test/run.sh` itself keeps its
# state inside a mktemp sandbox and does not create this.
/state/

# Repo .gitignore outranks the user's global excludesFile, so these negations
# protect test files whose NAMES trip common personal ignore rules. This is not
# hypothetical: a global `*secret*` rule silently kept
# test/cases/c133_secret_blocks_commit.sh — the test proving relay refuses to
# commit a credential — out of the published repository entirely. A security
# test that vanishes on the maintainer's own machine is worse than no test.
!test/cases/*secret*
!test/cases/*credential*
!test/**/*secret*
